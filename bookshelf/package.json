{
  "name": "bookshelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "jest --selectProjects unit && jest --selectProjects integration --runInBand",
    "test:watch": "jest --selectProjects unit --watch",
    "test:coverage": "jest --selectProjects unit --coverage && jest --selectProjects integration --runInBand --coverage --coverageDirectory coverage/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:test": "scripts/db/with-test-db.sh migrate deploy",
    "db:status:test": "scripts/db/with-test-db.sh migrate status",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "ingest:acquire": "tsx scripts/ingest/01-acquire.ts",
    "ingest": "tsx scripts/ingest/run.ts",
    "enrich:backfill": "tsx scripts/enrich/backfill.ts",
    "enrich:worker": "tsx scripts/enrich/worker.ts",
    "enrich:covers": "tsx scripts/enrich/covers.ts",
    "social:load": "tsx scripts/social/load-ratings.ts",
    "social:compute": "tsx scripts/social/compute-stats.ts",
    "db:reset": "prisma migrate reset",
    "storage:smoke": "tsx scripts/dev/azurite-smoke.ts",
    "bench:search": "tsx scripts/dev/bench-search.ts",
    "deploy:verify": "tsx scripts/deploy/verify.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.561.0",
    "next": "^16.3.1",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "prisma": "^5.22.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-leaflet": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "undici": "^8.10.0"
  }
}
