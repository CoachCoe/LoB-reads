generator client {
  provider        = "prisma-client-js"
  // Three schemas, per the data-layer spec:
  //   catalog — rebuilt monthly from Open Library dumps, disposable
  //   app     — user-owned data, survives every ingest
  //   seed    — synthetic/restricted data, added at M5
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the pooled connection. Serverless functions
  // open a connection per invocation, which exhausts a direct Postgres
  // connection limit quickly.
  url       = env("DATABASE_URL")
  // Migrations and introspection need a direct connection — they use
  // session-level features a transaction pooler does not support.
  // Locally the two are the same value; see .env.example.
  directUrl = env("DIRECT_URL")
  schemas   = ["app", "catalog"]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique // Always stored lowercased and trimmed
  passwordHash String
  name         String
  avatarUrl    String?
  bio          String?
  isModerator  Boolean  @default(false) // May remove any community-contributed map
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  shelves         Shelf[]
  reviews         Review[]
  readingSessions ReadingSession[]
  followers       Follow[]             @relation("Following")
  following       Follow[]             @relation("Follower")
  shelfItems      ShelfItem[]
  workLocations   WorkLocation[] // Locations this user contributed
  authorLocations AuthorLocation[] // Author locations this user contributed
  worldLinks      WorkFictionalWorld[]
  mapsUploaded    FictionalWorldMap[]  @relation("MapUploader")
  mapsEdited      FictionalWorldMap[]  @relation("MapEditor")

  @@map("users")
  @@schema("app")
}

model FictionalWorld {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Middle-earth", "Arrakis", "Macondo"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  works     WorkFictionalWorld[]
  locations WorkLocation[] // Fictional locations in this world
  maps      FictionalWorldMap[]

  @@map("fictional_worlds")
  @@schema("app")
}

// Community-editable: any signed-in user may edit title/description.
// Deletion is limited to the uploader or a moderator.
model FictionalWorldMap {
  id               String   @id @default(cuid())
  fictionalWorldId String
  imageUrl         String
  title            String
  description      String?
  addedById        String // Who uploaded it
  updatedById      String? // Who last edited it, if anyone
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  fictionalWorld FictionalWorld @relation(fields: [fictionalWorldId], references: [id], onDelete: Cascade)
  addedBy        User           @relation("MapUploader", fields: [addedById], references: [id], onDelete: Cascade)
  updatedBy      User?          @relation("MapEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([fictionalWorldId])
  @@index([addedById])
  @@map("fictional_world_maps")
  @@schema("app")
}

// Replaces Book.fictionalWorldId. This cannot be a column on catalog.works:
// the catalog is rebuilt from dumps every month and would erase it.
model WorkFictionalWorld {
  workKey   String   @map("work_key")
  worldId   String   @map("world_id")
  addedById String?  @map("added_by_id")
  addedAt   DateTime @default(now()) @map("added_at")

  world   FictionalWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  addedBy User?          @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@id([workKey, worldId])
  @@index([worldId])
  @@map("work_fictional_worlds")
  @@schema("app")
}

model Shelf {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelfItems ShelfItem[]

  @@unique([userId, name])
  @@map("shelves")
  @@schema("app")
}

model ShelfItem {
  id      String   @id @default(cuid())
  shelfId String
  workKey String   @map("work_key") // catalog.works.ol_key — no FK by design
  addedAt DateTime @default(now())

  // Denormalized from the parent shelf. A partial unique index cannot contain
  // a subquery, so enforcing "one exclusive shelf per work per user" in the
  // database requires both of these on the row itself. Kept in sync by the
  // shelf_items_sync_exclusive trigger, not by application code.
  userId      String  @map("user_id")
  isExclusive Boolean @default(false) @map("is_exclusive")

  // Relations
  shelf Shelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shelfId, workKey])
  @@index([workKey])
  @@index([userId])
  @@map("shelf_items")
  @@schema("app")
}

// Ratings and reviews attach to the WORK, not an edition — a rating of Dune
// is a rating of Dune, whichever printing you happened to read.
model Review {
  id        String   @id @default(cuid())
  userId    String
  workKey   String   @map("work_key")
  rating    Int      @db.SmallInt // 1-5
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workKey])
  @@index([workKey])
  @@map("reviews")
  @@schema("app")
}

// Progress binds to an EDITION where one is known, because page counts differ
// between printings, while the shelf and rating stay on the work.
//
// There is no unique constraint on (user, work): re-reads are a real thing and
// each is its own session. What IS enforced, by a partial unique index in the
// migration, is at most one OPEN session per user and work.
model ReadingSession {
  id          String    @id @default(cuid())
  userId      String
  workKey     String    @map("work_key")
  editionKey  String?   @map("edition_key") // catalog.editions.ol_key, if known
  currentPage Int       @default(0)
  pageCount   Int?      @map("page_count") // snapshot, so history survives an ingest
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workKey])
  @@index([userId, finishedAt])
  @@map("reading_sessions")
  @@schema("app")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  // Relations
  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
  @@schema("app")
}

// Crowdsourced location data - Wikipedia-style contributions

model WorkLocation {
  id               String   @id @default(cuid())
  workKey          String   @map("work_key")
  // Nullable: a contribution to the shared map outlives the account that made
  // it. ON DELETE SET NULL against a NOT NULL column is accepted at CREATE
  // TABLE and only fails later, when someone actually deletes their account.
  addedById        String?  @map("added_by_id")
  name             String // e.g., "Arrakis", "Paris", "Shire"
  type             String // "setting", "mentioned", "inspired_by"
  description      String?
  lat              Float? // Null for fictional locations, pinned to a world
  lng              Float?
  isFictional      Boolean  @default(false) @map("is_fictional")
  fictionalWorldId String?  @map("fictional_world_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  addedBy        User?           @relation(fields: [addedById], references: [id], onDelete: SetNull)
  fictionalWorld FictionalWorld? @relation(fields: [fictionalWorldId], references: [id], onDelete: SetNull)

  @@index([workKey])
  @@index([addedById])
  @@map("work_locations")
  @@schema("app")
}

model AuthorLocation {
  id          String   @id @default(cuid())
  authorKey   String   @map("author_key") // catalog.authors.ol_key
  addedById   String?  @map("added_by_id")
  name        String // e.g., "Oxford, UK"
  type        String // "birthplace", "residence", "death", "worked"
  description String?
  lat         Float
  lng         Float
  yearStart   Int?     @map("year_start")
  yearEnd     Int?     @map("year_end")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  addedBy User? @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([authorKey])
  @@index([addedById])
  @@map("author_locations")
  @@schema("app")
}

// ===========================================================================
// catalog — derived entirely from Open Library monthly dumps.
//
// Rebuilt wholesale on each ingest, so nothing irreplaceable may live here and
// nothing in `app` may hold a foreign key into it. Prisma owns the DDL so the
// migration history stays in one chain; the ingest itself uses COPY and raw
// SQL, because row-by-row inserts across tens of millions of rows take days.
// ===========================================================================

model CatalogAuthor {
  olKey        String   @id @map("ol_key") // OL34184A
  name         String
  personalName String?  @map("personal_name")
  birthDate    String?  @map("birth_date") // raw, unparsed
  deathDate    String?  @map("death_date")
  bio          String?
  photoId      BigInt?  @map("photo_id")
  wikidataId   String?  @map("wikidata_id")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  works CatalogWorkAuthor[]

  @@map("authors")
  @@schema("catalog")
}

model CatalogWork {
  olKey            String   @id @map("ol_key") // OL45804W
  title            String
  subtitle         String?
  description      String?
  firstPublishYear Int?     @map("first_publish_year")
  subjects         String[] @default([])
  coverEditionKey  String?  @map("cover_edition_key")
  editionCount     Int      @default(0) @map("edition_count")

  // Denormalized author names. Joining through work_authors on every search is
  // too slow at a million rows, per the spec.
  authorNames String? @map("author_names")

  // Maintained by a trigger, not by hand — see the migration. Prisma cannot
  // express tsvector, and it is never read through the client.
  searchVector Unsupported("tsvector")? @map("search_vector")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  authors  CatalogWorkAuthor[]
  editions CatalogEdition[]

  @@index([firstPublishYear])
  @@map("works")
  @@schema("catalog")
}

model CatalogWorkAuthor {
  workKey   String @map("work_key")
  authorKey String @map("author_key")
  position  Int    @default(0)

  work   CatalogWork   @relation(fields: [workKey], references: [olKey], onDelete: Cascade)
  author CatalogAuthor @relation(fields: [authorKey], references: [olKey], onDelete: Cascade)

  @@id([workKey, authorKey])
  @@index([authorKey])
  @@map("work_authors")
  @@schema("catalog")
}

model CatalogEdition {
  olKey          String   @id @map("ol_key") // OL7353617M
  workKey        String?  @map("work_key")
  title          String
  subtitle       String?
  isbn13         String?
  isbn10         String?
  publishers     String[] @default([])
  publishDateRaw String?  @map("publish_date_raw")
  publishYear    Int?     @map("publish_year")
  numberOfPages  Int?     @map("number_of_pages")
  languages      String[] @default([])
  physicalFormat String?  @map("physical_format")
  coverId        BigInt?  @map("cover_id")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  work CatalogWork? @relation(fields: [workKey], references: [olKey], onDelete: Cascade)

  @@index([workKey])
  @@index([isbn13])
  @@map("editions")
  @@schema("catalog")
}

// Cross-source identity. One row per (entity, source, id).
model CatalogExternalId {
  entityType String @map("entity_type") // work | edition | author
  entityKey  String @map("entity_key")
  source     String // google_books | hardcover | goodreads | wikidata
  externalId String @map("external_id")

  @@id([entityType, entityKey, source, externalId])
  @@index([source, externalId])
  @@map("external_ids")
  @@schema("catalog")
}

// Third-party enrichment, deliberately kept out of the canonical tables so
// provenance survives and any single source can be purged in one statement.
model CatalogEnrichment {
  entityType String    @map("entity_type")
  entityKey  String    @map("entity_key")
  source     String
  field      String // description | cover_url | genres
  value      Json
  fetchedAt  DateTime  @default(now()) @map("fetched_at")
  expiresAt  DateTime? @map("expires_at")

  @@id([entityType, entityKey, source, field])
  @@index([expiresAt])
  @@map("enrichment")
  @@schema("catalog")
}

// Which dump snapshot the catalog currently reflects, and how each run went.
model IngestRun {
  id               String    @id @default(cuid())
  dumpType         String    @map("dump_type") // works | editions | authors
  dumpPublished    DateTime? @map("dump_published")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  linesRead        BigInt    @default(0) @map("lines_read")
  rowsStaged       BigInt    @default(0) @map("rows_staged")
  linesQuarantined BigInt    @default(0) @map("lines_quarantined")
  status           String    @default("running") // running | completed | failed
  error            String?

  @@index([dumpType, startedAt])
  @@map("ingest_runs")
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// Ingest staging.
//
// Modelled here, despite being scratch space, because a table Prisma does not
// know about reads as drift: every `migrate diff` proposed dropping these.
// They are UNLOGGED (set in the migration — Prisma cannot express it) and are
// truncated and reloaded on every ingest.
// ---------------------------------------------------------------------------

model StageAuthor {
  olKey        String    @id @map("ol_key")
  revision     Int?
  lastModified DateTime? @map("last_modified")
  data         Json

  @@map("stage_authors")
  @@schema("catalog")
}

model StageWork {
  olKey        String    @id @map("ol_key")
  revision     Int?
  lastModified DateTime? @map("last_modified")
  data         Json

  @@map("stage_works")
  @@schema("catalog")
}

model StageEdition {
  olKey        String    @id @map("ol_key")
  revision     Int?
  lastModified DateTime? @map("last_modified")
  data         Json

  @@map("stage_editions")
  @@schema("catalog")
}
