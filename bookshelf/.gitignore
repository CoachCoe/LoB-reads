# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# SWC plugin cache. Invisible to git today only because its leaf directories
# happen to be empty.
/.swc

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which carries no secrets and is the only record of what
# a deployment needs configured. `.env*` had been swallowing it, so it was never
# committed and every required variable lived only on one developer's disk.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.env*.local

# Open Library dumps and ingest byproducts — large, regenerable
/data/raw
/data/quarantine

# Rating corpus — CC BY-SA 4.0, kept local. See ARCHITECTURE.md.
/data/ratings
