# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_URL is used at runtime; DIRECT_URL is used by `prisma migrate`,
# which needs a direct (non-pooled) connection.
#
# Local development — no pooler, so both point at the same database:
DATABASE_URL=postgresql://localhost:5432/bookshelf
DIRECT_URL=postgresql://localhost:5432/bookshelf
#
# Azure Database for PostgreSQL Flexible Server — these MUST differ. PgBouncer
# is built in on port 6432; the direct connection is 5432:
#   DATABASE_URL=postgresql://user:pass@srv.postgres.database.azure.com:6432/db?pgbouncer=true&sslmode=require
#   DIRECT_URL=postgresql://user:pass@srv.postgres.database.azure.com:5432/db?sslmode=require
#
# The `pgbouncer=true` flag is required, not cosmetic: in transaction pooling
# mode a server connection is handed to a different client between statements,
# and without the flag Prisma's prepared statements break under reuse.
# Pointing DIRECT_URL at the pooled port makes migrations fail — they take
# advisory locks and run DDL, neither of which survives a transaction pooler.

# Used by the integration tests, which truncate between tests. Must contain
# "test" — scripts/db/with-test-db.sh refuses anything else.
TEST_DATABASE_URL=postgresql://localhost:5432/bookshelf_test

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Must be the deployment's public URL in production, or callbacks break.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# Object storage — avatar and fictional-world map uploads
# ---------------------------------------------------------------------------
# Azure Blob Storage. The container is PRIVATE and served through the CDN.
#
# In Azure set only the account name: credentials come from the container's
# managed identity via DefaultAzureCredential, so nothing secret goes here.
# The identity needs the "Storage Blob Data Contributor" role on the container.
# AZURE_STORAGE_ACCOUNT=lobuploads
AZURE_STORAGE_CONTAINER=uploads

# Local development only — overrides the managed identity. This is Azurite's
# well-known emulator credential, published by Microsoft and useless against
# anything real. `docker compose up -d azurite` then `npm run storage:smoke`.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Set to true ONLY if the container really does allow anonymous blob reads.
# Leave unset in Azure, where the CDN does the serving.
# AZURE_STORAGE_PUBLIC_CONTAINER=true

# Public base URL uploads are served from — the Azure Front Door endpoint.
#
# Must be set at BUILD time too: it is baked into next.config.ts for the
# next/image host allowlist and the Content-Security-Policy. Build without it
# and uploaded images are blocked in the browser even though the upload
# succeeded.
#
# Not optional in the way it looks. The container is private, so with no CDN
# there is nothing that can serve an upload — the blob endpoint returns 403.
# The app therefore treats storage as unconfigured unless either this is set or
# AZURE_STORAGE_PUBLIC_CONTAINER says the container is readable, and upload
# endpoints return 503 rather than accepting files that could never render.
# CDN_URL=https://lob-uploads.z01.azurefd.net

# ---------------------------------------------------------------------------
# Enrichment (M4)
# ---------------------------------------------------------------------------
# Google Books fills in the descriptions Open Library is missing. A key is
# effectively required: keyless requests are answered with 429 from any shared
# address — verified against the live endpoint. Without this the worker backs
# off immediately and makes no progress.
# Get one at https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
