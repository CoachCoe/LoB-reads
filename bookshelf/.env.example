# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_URL is used at runtime; DIRECT_URL is used by `prisma migrate`,
# which needs a direct (non-pooled) connection.
#
# Local development — no pooler, so both point at the same database:
DATABASE_URL=postgresql://localhost:5432/bookshelf
DIRECT_URL=postgresql://localhost:5432/bookshelf
#
# Azure Database for PostgreSQL Flexible Server — these MUST differ. PgBouncer
# is built in on port 6432; the direct connection is 5432:
#   DATABASE_URL=postgresql://user:pass@srv.postgres.database.azure.com:6432/db?pgbouncer=true&sslmode=require
#   DIRECT_URL=postgresql://user:pass@srv.postgres.database.azure.com:5432/db?sslmode=require
#
# The `pgbouncer=true` flag is required, not cosmetic: in transaction pooling
# mode a server connection is handed to a different client between statements,
# and without the flag Prisma's prepared statements break under reuse.
# Pointing DIRECT_URL at the pooled port makes migrations fail — they take
# advisory locks and run DDL, neither of which survives a transaction pooler.

# Used by the integration tests, which truncate between tests. Must contain
# "test" — scripts/db/with-test-db.sh refuses anything else.
TEST_DATABASE_URL=postgresql://localhost:5432/bookshelf_test

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Must be the deployment's public URL in production, or callbacks break.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# How many proxies sit in front of the app and therefore may be trusted to have
# appended to X-Forwarded-For. Rate-limit keys are read that many hops from the
# RIGHT, because a proxy appends the peer it saw and everything to the left of
# that is client-supplied.
#
# SET IT EXPLICITLY, and 2 is the value for the deployment target. Front Door
# in front of Container Apps is TWO appending hops, because the Container Apps
# ingress appends as well — DEPLOYMENT.md and ci.yml both say so, and ci.yml
# sets "2". This file used to say "1 (the default) is correct behind a single
# Azure Front Door", which contradicted both and is the one contradiction in
# the doc set with a security consequence: guessing low returns a proxy's own
# address, identical for every client, which puts the whole site on one
# rate-limit bucket.
#
# Guessing HIGH fails the other way and is not yet guarded: a count longer than
# the real chain makes clientIpFromHeaders return null, so every per-IP limit
# silently disappears and account creation has no cap at all (SEC-6).
#
# 0 when nothing trusted is in front, which makes the app ignore the header
# rather than believe it.
# TRUSTED_PROXY_HOPS=2

# Overrides the fuzzy search arm's statement_timeout, in milliseconds. Default
# 900. Validated at import, so a non-numeric value fails at startup rather than
# turning /search into a 500 for typo'd queries only.
# SEARCH_FUZZY_TIMEOUT_MS=900

# A shared rate-limit store, once one exists. The in-process limiter is
# per-replica, so the effective limit is limit x replicas; deploy:verify
# requires either this or MAX_REPLICAS=1.
# RATE_LIMIT_STORE_URL=

# How the app identifies a client for rate limiting. One of these must be set,
# or the per-IP limits silently do not apply at all — deploy:verify fails when
# neither is.
#
# Preferred: a header the platform sets and the client cannot reach.
#   TRUSTED_CLIENT_IP_HEADER=x-azure-clientip
# Only set it once the app cannot be reached except through the proxy that sets
# it. A Container App's ingress FQDN is public by default, and a client reaching
# it directly can forge the header and take a fresh bucket per request.
# TRUSTED_CLIENT_IP_HEADER=

# Records the replica cap, so deploy:verify can assert the in-memory rate
# limiter's assumption holds. Must be 1 until the limiter moves to a shared
# store — otherwise effective limits are limit x replicas.
# MAX_REPLICAS=1

# ---------------------------------------------------------------------------
# Release gate
# ---------------------------------------------------------------------------
# The public URL of a RUNNING app, for `npm run deploy:verify` to check against.
# Fourteen of the gate's checks need it — both probes, the three CSP
# assertions, HSTS, and one timed query per search arm — and without it they are
# skipped. They used to be skipped and counted as passing; now the skip is a
# warning, and fatal when a deployment target is configured.
#
# Neither ci.yml nor deploy.yml sets it, so those fourteen have never run in
# automation. Adding it to deploy.yml is a workflow change and is recorded in
# docs/audit/2026-09-08-findings.md rather than made there.
# BASE_URL=https://app.example.com

# Set by the deploy workflow, not locally. deploy:verify reads them only to
# decide whether a deployment target exists — when one does, a missing BASE_URL
# is fatal rather than a warning.
# AZURE_RESOURCE_GROUP=
# CONTAINER_APP_NAME=

# ---------------------------------------------------------------------------
# Object storage — avatar and fictional-world map uploads
# ---------------------------------------------------------------------------
# Azure Blob Storage. The container is PRIVATE and served through the CDN.
#
# In Azure set only the account name: credentials come from the container's
# managed identity via DefaultAzureCredential, so nothing secret goes here.
# The identity needs the "Storage Blob Data Contributor" role on the container.
# AZURE_STORAGE_ACCOUNT=lobuploads
AZURE_STORAGE_CONTAINER=uploads

# Local development only — overrides the managed identity. This is Azurite's
# well-known emulator credential, published by Microsoft and useless against
# anything real. `docker compose up -d azurite` then `npm run storage:smoke`.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Set to true ONLY if the container really does allow anonymous blob reads.
# Leave unset in Azure, where the CDN does the serving.
# AZURE_STORAGE_PUBLIC_CONTAINER=true

# Public base URL uploads are served from — the Azure Front Door endpoint.
#
# Must be set at BUILD time too: it is baked into next.config.ts for the
# next/image host allowlist and the Content-Security-Policy. Build without it
# and uploaded images are blocked in the browser even though the upload
# succeeded.
#
# Not optional in the way it looks. The container is private, so with no CDN
# there is nothing that can serve an upload — the blob endpoint returns 403.
# The app therefore treats storage as unconfigured unless either this is set or
# AZURE_STORAGE_PUBLIC_CONTAINER says the container is readable, and upload
# endpoints return 503 rather than accepting files that could never render.
# CDN_URL=https://lob-uploads.z01.azurefd.net

# ---------------------------------------------------------------------------
# Enrichment (M4)
# ---------------------------------------------------------------------------
# Google Books fills in the descriptions Open Library is missing. A key is
# effectively required: keyless requests are answered with 429 from any shared
# address — verified against the live endpoint. Without this the worker backs
# off immediately and makes no progress.
# Get one at https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# ---------------------------------------------------------------------------
# Seed / restricted-licence corpus
# ---------------------------------------------------------------------------
# Whether scripts/social/compute-stats.ts folds the CC-BY-SA rating corpus in
# `seed` into the aggregates it computes. Defaults to false.
#
# Read only by that script, never at request time. The open question this note
# used to carry has been decided (PRD.md section 5, audit OQ-1/OQ-2): serving an
# aggregate is not redistributing the corpus, so the reads are not gated, and
# both surfaces carry CC-BY-SA attribution driven by seed_count.
# ENABLE_SEED_DATA=false
