# Copy to .env beside compose.yml. .env is gitignored.

# The public hostname, with DNS already pointing at the VM's public IP. Caddy
# requests the certificate on first start, which fails until DNS resolves.
DOMAIN=reads.example.org

# Hex only: it is interpolated into a connection URL, where +, / and = in a
# base64 value would need escaping.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Only the enrichment worker uses this. Optional.
GOOGLE_BOOKS_API_KEY=
